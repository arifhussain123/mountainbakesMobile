<resources>
     <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
          <!-- Customize your theme here. -->
          <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
          <!-- The app is fixed to one dark theme (no light/dark toggle — see
               shared/theme's useAppTheme). Without this, DayNight falls back to
               a white window background on a light-mode system, which shows
               through as a white band wherever an RN view doesn't fully cover
               the window instead of the app's own near-black background. -->
          <item name="android:windowBackground">@color/bootsplash_background</item>
          <!-- Defensive, not the fix for the white-strip bug itself (that was
               @react-navigation/native's own chrome defaulting to its light
               theme — see RootNavigator's `navigationTheme`). React Native 0.87
               forces edge-to-edge on targetSdk 35+ (WindowUtil.kt's
               `enableEdgeToEdge()`), which sets the nav bar transparent and, by
               default, paints Android's own light "contrast enforcement" scrim
               over it on a light-mode system — wrong for this app's single
               fixed dark theme. `android:navigationBarColor` below is just the
               pre-edge-to-edge fallback. -->
          <item name="android:navigationBarColor">@color/bootsplash_background</item>
          <item name="android:windowLightNavigationBar">false</item>
          <item name="android:enforceNavigationBarContrast">false</item>
     </style>

     <style name="BootTheme" parent="Theme.BootSplash">
          <item name="bootSplashBackground">@color/bootsplash_background</item>
          <item name="bootSplashLogo">@drawable/bootsplash_logo</item>
          <item name="postBootSplashTheme">@style/AppTheme</item>
     </style>
</resources>
