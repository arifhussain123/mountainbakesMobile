<resources>
    <!--
      The native half of the theme. These must track src/theme/colors.ts:
      app_background is `bg` (palette.cream50) and bootsplash_background is the
      same value, so the splash and the first React frame are one colour and the
      handoff has no seam.

      values-night/ carries the dark pair. Note what that can and cannot do: the
      OS night setting is the only signal available before React starts, so these
      follow the *device*, not the app's Light/Dark/System preference — which
      lives in MMKV and cannot be read this early. A user who forces Light on a
      dark device therefore gets a dark splash and a light app. That mismatch is
      one frame at the handoff; the alternative was a cream flash on every dark
      cold start, which is worse and was the previous behaviour.
    -->
    <color name="app_background">#FDF7EA</color>
    <color name="bootsplash_background">#FDF7EA</color>
</resources>
