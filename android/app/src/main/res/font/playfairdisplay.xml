<?xml version="1.0" encoding="utf-8"?>
<!--
  The serif, in exactly the two cuts the app draws.

  `type.display` is Playfair 700 upright — the wordmark and a hero figure — and
  `type.tagline` is Playfair 400 *italic*, the only italic in the app. Those two
  are the whole of it: v6 reserves the serif for the brand and sets every screen
  title in the UI face, so there is no 400-upright cut here because nothing may
  ask for one. A request for one resolves to the nearest declared weight rather
  than to a system serif, which is the right failure.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/playfairdisplay_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/playfairdisplay_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
    <font
        android:font="@font/playfairdisplay_italic"
        android:fontStyle="italic"
        android:fontWeight="400"
        app:font="@font/playfairdisplay_italic"
        app:fontStyle="italic"
        app:fontWeight="400" />
</font-family>
