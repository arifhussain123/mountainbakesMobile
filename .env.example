# Copy to .env.development (and .env.production) and fill in.
# PUBLIC VALUES ONLY - this file's contents ship inside the APK/IPA.
# The Supabase service-role key belongs on the Express server, never here.

ENVIRONMENT=development

# Express API origin, no trailing slash.
# Reached over USB via `adb reverse tcp:3001 tcp:3001`, which works on a physical
# device AND an emulator. (10.0.2.2 is the emulator-only alternative: on a real
# phone it is unroutable and every request fails, which looks like a broken app
# rather than a wrong address.) This is what .env.development actually uses.
API_URL=http://localhost:3001

# Supabase project URL and anon/publishable key (same values the web app uses).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>

# Web app origin. Password-recovery emails link to <WEB_URL>/reset-password,
# because the app has no deep-link scheme registered.
WEB_URL=http://localhost:3000

# Optional. Crash reporting stays off when blank.
SENTRY_DSN=
